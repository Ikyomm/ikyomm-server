{
  "name": "ikyomm-server",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "turbo run build",
    "build:gateway": "turbo run build --filter=@ikyomm/gateway",
    "build:auth": "turbo run build --filter=@ikyomm/auth",
    "build:kernel": "turbo run build --filter=@ikyomm/kernel",
    "build:company": "turbo run build --filter=@ikyomm/company",
    "build:ommpods": "turbo run build --filter=@ikyomm/ommpods",
    "build:ecommerce": "turbo run build --filter=@ikyomm/ecommerce",
    "dev:build-deps": "pnpm --filter @ikyomm/logger run build && pnpm --filter @ikyomm/database run build && pnpm --filter @ikyomm/static run build && pnpm --filter @ikyomm/utils run build && pnpm --filter @ikyomm/notification run build",
    "dev": "turbo run dev --filter=@ikyomm/gateway --filter=@ikyomm/auth --filter=@ikyomm/kernel --filter=@ikyomm/company --filter=@ikyomm/ommpods --filter=@ikyomm/ecommerce",
    "dev:email": "pnpm --filter @ikyomm/notification run email:dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "lint:gateway": "turbo run lint --filter=@ikyomm/gateway",
    "lint:auth": "turbo run lint --filter=@ikyomm/auth",
    "lint:kernel": "turbo run lint --filter=@ikyomm/kernel",
    "lint:company": "turbo run lint --filter=@ikyomm/company",
    "lint:ommpods": "turbo run lint --filter=@ikyomm/ommpods",
    "lint:ecommerce": "turbo run lint --filter=@ikyomm/ecommerce",
    "type-check": "turbo run type-check",
    "type-check:gateway": "turbo run type-check --filter=@ikyomm/gateway",
    "type-check:auth": "turbo run type-check --filter=@ikyomm/auth",
    "type-check:kernel": "turbo run type-check --filter=@ikyomm/kernel",
    "type-check:company": "turbo run type-check --filter=@ikyomm/company",
    "type-check:ommpods": "turbo run type-check --filter=@ikyomm/ommpods",
    "type-check:ecommerce": "turbo run type-check --filter=@ikyomm/ecommerce",
    "clean": "turbo run clean",
    "clean:full": "turbo run clean && rm -rf node_modules",
    "clean:gateway": "turbo run clean --filter=@ikyomm/gateway",
    "clean:auth": "turbo run clean --filter=@ikyomm/auth",
    "clean:kernel": "turbo run clean --filter=@ikyomm/kernel",
    "clean:company": "turbo run clean --filter=@ikyomm/company",
    "clean:ommpods": "turbo run clean --filter=@ikyomm/ommpods",
    "clean:ecommerce": "turbo run clean --filter=@ikyomm/ecommerce",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "docker:up": "docker compose --env-file env/.env -f docker/docker-compose.yml up",
    "docker:up:d": "docker compose --env-file env/.env -f docker/docker-compose.yml up -d",
    "docker:up:build": "docker compose --env-file env/.env -f docker/docker-compose.yml up --build",
    "docker:up:build:d": "docker compose --env-file env/.env -f docker/docker-compose.yml up --build -d",
    "docker:down": "docker compose --env-file env/.env -f docker/docker-compose.yml down",
    "docker:down:v": "docker compose --env-file env/.env -f docker/docker-compose.yml down -v",
    "docker:logs": "docker compose --env-file env/.env -f docker/docker-compose.yml logs -f",
    "docker:logs:gateway": "docker compose --env-file env/.env -f docker/docker-compose.yml logs -f gateway",
    "docker:logs:auth": "docker compose --env-file env/.env -f docker/docker-compose.yml logs -f auth",
    "docker:logs:kernel": "docker compose --env-file env/.env -f docker/docker-compose.yml logs -f kernel",
    "docker:logs:company": "docker compose --env-file env/.env -f docker/docker-compose.yml logs -f company",
    "docker:logs:ommpods": "docker compose --env-file env/.env -f docker/docker-compose.yml logs -f ommpods",
    "docker:logs:ecommerce": "docker compose --env-file env/.env -f docker/docker-compose.yml logs -f ecommerce",
    "docker:ps": "docker compose --env-file env/.env -f docker/docker-compose.yml ps",
    "docker:build": "docker compose --env-file env/.env -f docker/docker-compose.yml build",
    "docker:size": "bash scripts/docker-image-size.sh",
    "docker:size:build": "bash scripts/docker-image-size.sh --build",
    "docker:prod:up": "docker compose --env-file env/.env.prod -f docker/docker-compose.prod.yml up",
    "docker:prod:up:d": "docker compose --env-file env/.env.prod -f docker/docker-compose.prod.yml up -d",
    "docker:prod:up:build": "docker compose --env-file env/.env.prod -f docker/docker-compose.prod.yml up --build",
    "docker:prod:up:build:d": "docker compose --env-file env/.env.prod -f docker/docker-compose.prod.yml up --build -d",
    "docker:prod:down": "docker compose --env-file env/.env.prod -f docker/docker-compose.prod.yml down",
    "docker:prod:down:v": "docker compose --env-file env/.env.prod -f docker/docker-compose.prod.yml down -v",
    "docker:prod:logs": "docker compose --env-file env/.env.prod -f docker/docker-compose.prod.yml logs -f",
    "docker:prod:logs:gateway": "docker compose --env-file env/.env.prod -f docker/docker-compose.prod.yml logs -f gateway",
    "docker:prod:logs:auth": "docker compose --env-file env/.env.prod -f docker/docker-compose.prod.yml logs -f auth",
    "docker:prod:logs:kernel": "docker compose --env-file env/.env.prod -f docker/docker-compose.prod.yml logs -f kernel",
    "docker:prod:logs:company": "docker compose --env-file env/.env.prod -f docker/docker-compose.prod.yml logs -f company",
    "docker:prod:logs:ommpods": "docker compose --env-file env/.env.prod -f docker/docker-compose.prod.yml logs -f ommpods",
    "docker:prod:logs:ecommerce": "docker compose --env-file env/.env.prod -f docker/docker-compose.prod.yml logs -f ecommerce",
    "docker:prod:ps": "docker compose --env-file env/.env.prod -f docker/docker-compose.prod.yml ps",
    "docker:prod:build": "docker compose --env-file env/.env.prod -f docker/docker-compose.prod.yml build",
    "health:gateway": "curl -s http://localhost:8000/health | jq",
    "health:auth": "curl -s http://localhost:8000/api/auth/health | jq",
    "health:kernel": "curl -s http://localhost:8000/api/kernel/health | jq",
    "health:company": "curl -s http://localhost:8000/api/company/health | jq",
    "health:ommpods": "curl -s http://localhost:8000/api/ommpods/health | jq",
    "health:ecommerce": "curl -s http://localhost:8000/api/ecommerce/health | jq",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "commitlint": "commitlint",
    "deps:check": "bash -lc 'pnpm outdated -r; status=$?; if [ \"$status\" -gt 1 ]; then exit \"$status\"; fi'",
    "deps:bump": "pnpm update -r --latest",
    "deps:reinstall": "pnpm install --force",
    "db:generate": "pnpm --filter @ikyomm/database db:generate",
    "db:migrate": "pnpm --filter @ikyomm/database db:migrate",
    "db:push": "pnpm --filter @ikyomm/database db:push",
    "db:studio": "pnpm --filter @ikyomm/database db:studio"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc,md,css,scss,yml,yaml}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@types/node": "^25.9.2",
    "drizzle-orm": "^0.45.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "pg": "^8.21.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "turbo": "^2.10.6",
    "typescript": "^6.0.3",
    "ultracite": "^7.8.1"
  }
}
