{
  "name": "@ikyomm/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:deps": "pnpm --dir ../.. --filter \"@ikyomm/auth^...\" run build",
    "build": "tsup --config ../../tsup.config.ts",
    "predev": "pnpm run build:deps",
    "dev": "tsx watch --env-file=../../env/.env src/index.ts",
    "prestart": "pnpm run build:deps",
    "start": "node dist/index.js",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "pretype-check": "pnpm run build:deps",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "db:auth:generate": "set -a && . ../../env/.env && set +a && pnpm dlx auth@latest generate --config src/lib/auth/index.ts --output ../../packages/database/src/schemas/auth/schema.ts --yes",
    "db:auth:secret": "pnpm dlx auth@latest secret",
    "db:auth:info": "set -a && . ../../env/.env && set +a && pnpm dlx auth@latest info --config src/lib/auth/index.ts --json"
  },
  "dependencies": {
    "@better-auth/infra": "^0.3.7",
    "@better-auth/redis-storage": "^1.6.26",
    "@hono/node-server": "^2.1.0",
    "@ikyomm/database": "workspace:*",
    "@ikyomm/logger": "workspace:*",
    "@ikyomm/notification": "workspace:*",
    "@ikyomm/utils": "workspace:*",
    "@t3-oss/env-core": "^0.13.11",
    "better-auth": "^1.6.26",
    "hono": "^4.13.0",
    "ioredis": "^6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@ikyomm/typescript-config": "workspace:*",
    "@types/node": "^26.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
