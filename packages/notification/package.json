{
  "name": "@ikyomm/notification",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup --config ../../tsup.config.ts",
    "email:dev": "node ./scripts/clean-email-appledouble.mjs && set -a && . ../../env/.env && set +a && email dev --dir src/email/templates --port \"${EMAIL_PREVIEW_PORT:-3005}\"",
    "email:export": "node ./scripts/clean-email-appledouble.mjs && set -a && . ../../env/.env && set +a && email export --dir src/email/templates --outDir dist/email-preview",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-email": "^6.9.2",
    "resend": "^6.18.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@ikyomm/typescript-config": "workspace:*",
    "@react-email/ui": "6.9.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "tsup": "^8.5.1",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2"
  }
}
