# Local development env (single global file)
# Copy: cp env/.env.example env/.env

NODE_ENV=development
LOG_LEVEL=info
LOG_FORMAT=pretty
LOG_HEALTHCHECKS=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003,http://localhost:3005,http://localhost:3006,http://localhost:3010,http://localhost:5173,http://localhost:6010,http://localhost:6011,http://localhost:8000,http://127.0.0.1:3005,http://127.0.0.1:3006,http://127.0.0.1:3010,http://YOUR_LAN_IP:3000,http://YOUR_LAN_IP:3002,http://YOUR_LAN_IP:3003,http://YOUR_LAN_IP:3005,http://YOUR_LAN_IP:3006,http://YOUR_LAN_IP:3010,http://YOUR_LAN_IP:6010,http://YOUR_LAN_IP:6011,http://YOUR_LAN_IP:8000,https://admin.ikyomm.com,https://app.ikyomm.com,https://tablet.ikyomm.com,https://business.ommpdos.com,https://business.ommpods.com,https://server.ikyomm.com
# Optional PostgreSQL pool tuning query params:
# pool_max, pool_min, connect_timeout_ms, idle_timeout_ms, statement_timeout_ms,
# query_timeout_ms, max_uses, max_lifetime_seconds, keep_alive, keep_alive_initial_delay_ms
DATABASE_URL=postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>?pool_max=20&pool_min=2&connect_timeout_ms=5000&idle_timeout_ms=10000&statement_timeout_ms=15000&query_timeout_ms=15000
REDIS_URL=redis://localhost:6379

GATEWAY_PORT=8000
GATEWAY_HOST_PORT=8000
GATEWAY_NODE_OPTIONS=--max-old-space-size=512
AUTH_PORT=6001
AUTH_HOST_PORT=6001
AUTH_NODE_OPTIONS=--max-old-space-size=768
KERNEL_PORT=6003
KERNEL_HOST_PORT=6003
KERNEL_NODE_OPTIONS=--max-old-space-size=768
COMPANY_PORT=6005
COMPANY_HOST_PORT=6005
COMPANY_NODE_OPTIONS=--max-old-space-size=512
OMMPODS_PORT=6007
OMMPODS_HOST_PORT=6007
OMMPODS_NODE_OPTIONS=--max-old-space-size=512
OMMPODS_SESSION_START_END_DELAY_SECONDS=20
OMMPODS_SESSION_START_INTRODUCTORY_VIDEO_DURATION=30
EMAIL_PREVIEW_PORT=3005

AUTH_SERVICE_URL=http://localhost:6001
KERNEL_SERVICE_URL=http://localhost:6003
COMPANY_SERVICE_URL=http://localhost:6005
OMMPODS_SERVICE_URL=http://localhost:6007

BETTER_AUTH_SECRET=<set-a-long-random-secret>
BETTER_AUTH_URL=http://localhost:8000/api/auth
BETTER_AUTH_CROSS_SUBDOMAIN_COOKIES=false
BETTER_AUTH_COOKIE_DOMAIN=
BETTER_AUTH_API_KEY=<set-your-better-auth-api-key>

# Production example for auth on server.ikyomm.com and apps on the same site:
# CORS_ALLOWED_ORIGINS=https://admin.ikyomm.com,https://app.ikyomm.com,https://tablet.ikyomm.com,https://server.ikyomm.com
# BETTER_AUTH_URL=https://server.ikyomm.com/api/auth
# BETTER_AUTH_CROSS_SUBDOMAIN_COOKIES=true
# BETTER_AUTH_COOKIE_DOMAIN=ikyomm.com

RESEND_API_KEY=replace_me
RESEND_FROM_NAME=Ommpods
RESEND_FROM=no-reply@example.com
RESEND_TIMEOUT=12
